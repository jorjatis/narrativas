{{#if months.length}}
  <nav class="months-nav" aria-label="Índice de meses" data-months-nav>
    <ul class="months-nav__list">
      {{#each months}}
        <li class="months-nav__item">
          <a class="months-nav__link" href="#{{slugify title}}" data-month-link>
            <span data-lang-text="es">{{title}}</span>
            {{#if titleEn}}
              <span data-lang-text="en">{{titleEn}}</span>
            {{/if}}
          </a>
        </li>
      {{/each}}
    </ul>
  </nav>
{{/if}}
