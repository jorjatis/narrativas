<article class="card{{#if gif}} card--has-preview{{/if}}" data-reveal{{#if gif}} data-media-preview{{/if}}>
  <a class="card-media" href="{{articleUrl}}" target="_blank" rel="noopener noreferrer" aria-label="Abrir {{title}}">
    <img
      src="assets/images/covers/{{titleMedia}}.webp"
      alt=""
      width="512"
      height="288"
      class="card-media-thumbnail"
      decoding="async"
      {{#if isLcp}}
        fetchpriority="high"
      {{else}}
        loading="lazy"
      {{/if}}
    >
    {{#if gif}}
      <video
        class="card-media-preview"
        muted
        loop
        playsinline
        preload="none"
        width="512"
        height="288"
        aria-hidden="true"
        data-preview-src="assets/images/covers/{{titleMedia}}.mp4"
      ></video>
    {{/if}}
  </a>
  <div class="card-body">
    <h3 class="card-title">
      <a class="card-title-link" href="{{articleUrl}}" target="_blank" rel="noopener noreferrer">
        <span data-lang-text="es">{{title}}</span>
        {{#if titleEn}}
          <span data-lang-text="en">{{titleEn}}</span>
        {{else}}
          <span data-lang-text="en">{{title}}</span>
        {{/if}}
      </a>
    </h3>
    <div class="card-actions">
      <a class="v-btn v-btn-g v-btn--m" href="{{articleUrl}}" target="_blank" rel="noopener noreferrer" data-i18n="readAbc" aria-label="Leer {{title}} en ABC">Leer en ABC</a>
      <a class="v-btn v-btn-s" href="{{netlifyUrl}}" target="_blank" rel="noopener noreferrer" data-i18n="viewMockup" aria-label="Ver mockup de archivo de {{title}}">Ver mockup</a>
    </div>
  </div>
</article>
