      <iframe title="Producción de petróleo OPEP (2001-2026)" aria-label="Líneas" id="datawrapper-chart-XWxij" src="https://datawrapper.dwcdn.net/XWxij/1/" scrolling="no" frameborder="0" style="width:0;min-width:100%!important;border:none" height="423" data-external="1"></iframe>
