{{!--
  Arranque sin parpadeo. Va DENTRO de .v-elec y como primer hijo: se ejecuta mientras el navegador lee el HTML,
  antes de pintar nada. Oculta toda la visual (.is-booting: invisible, pero ocupando su sitio) hasta que main.js
  la tiene lista, y mira lo guardado en este navegador para elegir la vista inicial:
    - test terminado                -> .is-widgets-on  (resultados)
    - test a medias                 -> .is-resume      (el botón dice "Continuar")
    - nada guardado                 -> portada con "Empezar"
  Si main.js no llegara, la visual aparece igualmente a los 8 s (CSS).
  Además pone la cabecera del medio siempre en su variante t3 (v-h--t3), sea cual sea la que traiga.
  main.js lo confirma después con el estado real y corrige si hiciera falta. Si el CMS quitara este <script>,
  todo funciona igual que antes (solo vuelve el cambio de vista al cargar).
  Debe coincidir con src/js/elecciones (clave y SCHEMA): lo comprueba tests/arranque.test.js.
--}}
<script>
(() => {
  const cabecera = document.querySelector('header.v-h');
  if (cabecera) {
    cabecera.classList.remove(...[...cabecera.classList].filter((c) => /^v-h--t\d+$/.test(c)));
    cabecera.classList.add('v-h--t3');
  }
  const el = document.currentScript?.parentNode;
  if (!el?.classList) return;
  el.classList.add('is-booting');
  try {
    const ls = window.localStorage;
    const pre = 'vocento:test-electoral:generales-29n:';
    const h = location.hostname.split('.');
    const m = h.length > 1 ? h[h.length - 2] : '';
    let raw = ls.getItem(pre + m);
    if (!raw) {
      const claves = [];
      for (let i = 0; i < ls.length; i++) {
        const k = ls.key(i);
        if (k?.startsWith(pre)) claves.push(k);
      }
      if (claves.length === 1) raw = ls.getItem(claves[0]);
    }
    const e = raw && JSON.parse(raw);
    if (!e || e.schema !== 5) return;
    if (e.completado) el.classList.add('is-widgets-on');
    else if (e.respuestasUser?.length) el.classList.add('is-resume');
  } catch {
    {{!-- sin localStorage: se queda la portada --}}
  }
})();
</script>
