<div class="v-n-suh v-n-suh--02">
  <span class="v-n-suh__l"></span>
  <h3 class="v-n-suh__t">Elige al nuevo 10 de la Selección</h3>
</div>

<div class="v-n-dnd-player">
  <p class="v-n-dnd-player__lead" id="dnd-player-lead">Pulsa y arrastra un jugador encima del 10, o selecciónalo con el teclado y pulsa Enter</p>

  <div class="v-n-dnd-player__c">
    <div class="v-n-dnd-player__drag-item v-n-dnd-player__drag-item--01" data-vertex="01" data-id="player01" data-votes="0" data-share="0" role="button" tabindex="0" aria-describedby="dnd-player-lead dnd-drop-label">
      <p class="v-n-dnd-player__name">
        <span class="v-n-dnd-player__name-l"></span>
        Lautaro <br> Martínez
      </p>
      <figure class="v-n-dnd-player__img">
        <img
          src="https://s1.abcstatics.com/comun/narrativas/redaccion/2026/09/15/diez-argentina/images/dnd-player-mock.webp"
          alt="Lautaro Martínez" width="120" height="120" loading="lazy" decoding="async" draggable="false">
      </figure>
    </div>
    <div class="v-n-dnd-player__drag-item v-n-dnd-player__drag-item--02" data-vertex="02" data-id="player02" data-votes="0" data-share="0" role="button" tabindex="0" aria-describedby="dnd-player-lead dnd-drop-label">
      <p class="v-n-dnd-player__name">
        <span class="v-n-dnd-player__name-l"></span>
        Enzo <br> Fernández
      </p>
      <figure class="v-n-dnd-player__img">
        <img
          src="https://s1.abcstatics.com/comun/narrativas/redaccion/2026/09/15/diez-argentina/images/dnd-player-mock.webp"
          alt="Enzo Fernández" width="120" height="120" loading="lazy" decoding="async" draggable="false">
      </figure>
    </div>
    <div class="v-n-dnd-player__drag-item v-n-dnd-player__drag-item--03" data-vertex="03" data-id="player03" data-votes="0" data-share="0" role="button" tabindex="0" aria-describedby="dnd-player-lead dnd-drop-label">
      <p class="v-n-dnd-player__name">
        <span class="v-n-dnd-player__name-l"></span>
        Alexis <br> Allister
      </p>
      <figure class="v-n-dnd-player__img">
        <img
          src="https://s1.abcstatics.com/comun/narrativas/redaccion/2026/09/15/diez-argentina/images/dnd-player-mock.webp"
          alt="Alexis Allister" width="120" height="120" loading="lazy" decoding="async" draggable="false">
      </figure>
    </div>
    <div class="v-n-dnd-player__drag-item v-n-dnd-player__drag-item--04" data-vertex="04" data-id="player04" data-votes="0" data-share="0" role="button" tabindex="0" aria-describedby="dnd-player-lead dnd-drop-label">
      <p class="v-n-dnd-player__name">
        <span class="v-n-dnd-player__name-l"></span>
        Julián <br> Álvarez
      </p>
      <figure class="v-n-dnd-player__img">
        <img
          src="https://s1.abcstatics.com/comun/narrativas/redaccion/2026/09/15/diez-argentina/images/dnd-player-mock.webp"
          alt="Julián Álvarez" width="120" height="120" loading="lazy" decoding="async" draggable="false">
      </figure>
    </div>
    <div class="v-n-dnd-player__drag-item v-n-dnd-player__drag-item--05" data-vertex="05" data-id="player05" data-votes="0" data-share="0" role="button" tabindex="0" aria-describedby="dnd-player-lead dnd-drop-label">
      <p class="v-n-dnd-player__name">
        <span class="v-n-dnd-player__name-l"></span>
        Rodrigo <br> De Paul
      </p>
      <figure class="v-n-dnd-player__img">
        <img
          src="https://s1.abcstatics.com/comun/narrativas/redaccion/2026/09/15/diez-argentina/images/dnd-player-mock.webp"
          alt="Rodrigo De Paul" width="120" height="120" loading="lazy" decoding="async" draggable="false">
      </figure>
    </div>
    <div class="v-n-dnd-player__drop-zone" role="region" aria-labelledby="dnd-drop-label">
      <p class="v-n-dnd-player__drop-label" id="dnd-drop-label">Zona para soltar el dorsal 10</p>
      <svg class="v-n-dnd-player__flag" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 198 198"
        aria-hidden="true">
        <path fill="#88e0ff"
          d="M39.6 19.79v158.409C15.55 160.139 0 131.379 0 98.999s15.55-61.14 39.6-79.21M99 0c6.78 0 13.4.68 19.8 1.98v194.04c-6.4 1.3-13.02 1.98-19.8 1.98s-13.4-.68-19.8-1.98V1.98C85.6.68 92.22 0 99 0M198 99c0 32.379-15.55 61.139-39.6 79.199V19.789C182.45 37.86 198 66.61 198 99" />
      </svg>
      <svg class="v-n-dnd-player__num" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 198 198"
        aria-hidden="true">
        <path fill="#000"
          d="m139.08 54.61 12.08 12.08v64.821l-12.08 12.08H105.5l-12.08-12.08v-64.82l12.08-12.08zm-25.1 70.301h16.61l.51-.55.05-.05.46-.5v-49.42l-.46-.5-.05-.05-.51-.55h-16.62l-.51.55-.05.05-.46.5v49.42l.46.5.05.05.51.55m25.82-72.02h-35L91.7 65.98v66.25l13.09 13.09h35l13.09-13.09v-66.25zm-25.06 70.3-.05-.05v-48.07l.05-.05h15.11l.05.05v48.07l-.05.05z" />
        <path fill="#000"
          d="M138.26 56.58h-31.95L95.38 67.51v63.19l10.93 10.93h31.95l10.93-10.93V67.51zm-4.68 68.01-2.13 2.29h-18.33l-2.13-2.29V73.62l2.13-2.29h18.33l2.13 2.29zM74.97 54.4v70.23h5.84v18.96H49.73v-18.96h5.84V73.36h-8.72V54.4h28.13m1.71-1.72H45.12v22.41h8.72v47.83H48v22.41h34.52v-22.41h-5.84V52.68z" />
        <path fill="#000" d="M73 126.599v-70.23H48.81V71.4h8.72v55.2h-5.84v15.03h27.15v-15.03z" />
      </svg>
    </div>
    <div class="v-n-dnd-player__bg" aria-hidden="true">
      <div class="v-n-dnd-player__pentagon v-n-dnd-player__pentagon--01">
        <svg width="703" height="669" viewBox="0 0 703 669" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M702.243 255.509L568.239 667.932H134.592L0.58725 255.509L351.415 0.617188L702.243 255.509Z"
            stroke="black" />
        </svg>

      </div>
      <div class="v-n-dnd-player__pentagon v-n-dnd-player__pentagon--02">
        <svg width="545" height="519" viewBox="0 0 545 519" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M543.192 198.539L439.788 516.783H105.167L1.76285 198.539L272.478 1.85449L543.192 198.539Z"
            stroke="#88E0FF" stroke-width="3" />
        </svg>

      </div>
    </div>

    <div class="v-n-dnd-player__result" aria-live="polite" aria-atomic="true">
      <p class="v-n-dnd-player__vote">
        <span class="v-n-dnd-player__vote-kicker">Has votado a</span>
        <strong class="v-n-dnd-player__vote-name"></strong>
      </p>
      <div class="v-n-dnd-player__hero">
        <div class="v-n-dnd-player__laurel v-n-dnd-player__laurel--l" aria-hidden="true">
          <div class="v-n-dnd-player__laurel-motion">
            {{> includes/dnd-laurel id="dnd-laurel-l"}}
          </div>
        </div>
        <div class="v-n-dnd-player__laurel v-n-dnd-player__laurel--r" aria-hidden="true">
          <div class="v-n-dnd-player__laurel-motion">
            {{> includes/dnd-laurel id="dnd-laurel-r"}}
          </div>
        </div>
      </div>
      <div class="v-n-dnd-player__ranking">
        <p class="v-n-dnd-player__ranking-title">La elección de nuestros lectores</p>
        <ol class="v-n-dnd-player__ranking-list"></ol>
        <div class="v-btn-c v-btn-c--c">
          <button type="button" class="v-btn v-btn--m v-n-dnd-player__again">Volver a votar</button>
        </div>
      </div>
    </div>
  </div>
</div>
