        <img class="v-n-chrono__names" src="assets/images/crono-detenidos-names.svg" alt="" width="739" height="130">
        <div class="v-n-chrono__faces-gap" aria-hidden="true"></div>
        <img class="v-n-chrono__body" src="assets/images/crono-detenidos-body.svg" alt="Cronología de detenidos" width="739" height="6581">
      </div>
      <div class="v-n-chrono__heads" aria-hidden="true">
        <img src="assets/images/crono-detenidos-faces.svg" alt="" width="739" height="52">
      </div>

      <div class="v-n-chrono__graphic v-n-chrono__graphic--mov">
        <div class="v-n-chrono__names-gap" aria-hidden="true"></div>
        <img class="v-n-chrono__body" src="assets/images/crono-detenidos-mov-body.svg" alt="Cronología de detenidos" width="305" height="6588">
      </div>
      <div class="v-n-chrono__names-sticky" aria-hidden="true">
        <img src="assets/images/crono-detenidos-mov-names.svg" alt="" width="305" height="145">
      </div>
