<div class="v-elec-intro">
  {{> includes/elections-heading }}
  <h1 class="v-elec-intro__t">¿De qué partido estás más cerca?</h1>
  <p class="v-elec-intro__st">Responde a las preguntas y descubre qué candidato se acerca más a tus ideas políticas de cara a las próximas elecciones</p>
  <p class="v-elec-intro__note">Todas las respuestas de este cuestionario son anónimas</p>
  <button class="v-btn v-btn-g v-btn--xl" id="v-elec-start" type="button"><span class="v-elec-intro__empezar">Empezar</span><span class="v-elec-intro__continuar">Continuar</span></button>
</div>

<div class="v-elec-test">
  {{> includes/elections-heading }}
  <div class="v-elec-test__sld" id="v-elec-test-sld">
    <button class="v-elec-test__nav" id="v-elec-test-prev" type="button" data-elec-prev aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true">
        <path d="M10 20L0 10L10 0L11.775 1.775L3.55 10L11.775 18.225L10 20Z" fill="#202020" />
      </svg>
    </button>
    <button class="v-elec-test__nav" id="v-elec-test-next" type="button" data-elec-next aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true">
        <path d="M1.775 20L0 18.225L8.225 10L0 1.775L1.775 0L11.775 10L1.775 20Z" fill="#1C1B1F" />
      </svg>
    </button>

    <div class="v-elec-test__track">
      <ul class="v-elec-test__list" id="v-elec-test-list">
        {{#each elecciones.preguntas}}
        <li class="v-elec-test__item v-elec-test__item--q" data-elec-q="{{id}}">
          <div class="v-elec-test__card">
            <div class="v-elec-test__prog" data-elec-step="{{n}}">
              <b>{{n}}</b>/<span>{{total}}</span>
              <div class="v-elec-test__prog-bar">
                <div class="v-elec-test__prog-val"></div>
              </div>
            </div>

            <h2 class="v-elec-test__qt">{{claim}}</h2>

            {{#if contexto}}
            <div class="v-elec-test__more">
              <button class="v-elec-test__more-bt" type="button" aria-expanded="false">
                <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <use href="#icon-elec-more"></use>
                </svg>
                <span class="v-elec-test__more-bt--1">Necesito saber más</span>
                <span class="v-elec-test__more-bt--2">Cerrar</span>
              </button>
              <div class="v-elec-test__more-txt"{{#if contextoPendiente}} data-elec-pendiente{{/if}}>{{contexto}}</div>
            </div>
            {{/if}}

            <fieldset class="v-elec-test__group">
              <legend class="v-elec-test__lg">Pregunta {{n}} de {{total}}: {{familia}}</legend>
              {{#each opciones}}
              <div class="v-elec-test__opt">
                <input type="radio" name="elec-q-{{../n}}" id="{{idInput}}" value="{{valor}}">
                <label class="v-elec-test__bt" data-elec-next for="{{idInput}}">
                  <span class="v-elec-test__ic">
                    <svg width="{{ancho}}" height="{{alto}}" viewBox="0 0 {{ancho}} {{alto}}" fill="none" aria-hidden="true">
                      <use href="#icon-elec-gauge-{{icono}}"></use>
                    </svg>
                  </span>
                  <span>{{etiqueta}}</span>
                </label>
              </div>
              {{/each}}
            </fieldset>
          </div>
        </li>

        {{/each}}
        <li class="v-elec-test__item v-elec-test__item--party">
          <div class="v-elec-test__card">
            <div class="v-elec-test__prog" data-elec-step="{{elecciones.total}}">
              <b>{{elecciones.total}}</b>/<span>{{elecciones.total}}</span>
              <div class="v-elec-test__prog-bar">
                <div class="v-elec-test__prog-val"></div>
              </div>
            </div>

            <h2 class="v-elec-test__qt">¿Qué partido crees que se acerca más a tu posición ideológica?</h2>

            <fieldset class="v-elec-test__group v-elec-test__group--p">
              <legend class="v-elec-test__lg">Partido que crees más cercano</legend>
              {{#each elecciones.partidos}}
              <div class="v-elec-test__opt">
                <input type="radio" name="elec-p" id="elec-p-{{slug}}" value="{{slug}}">
                <label class="v-elec-test__bt v-elec-test__bt--p" for="elec-p-{{slug}}">
                  <span class="v-elec-test__pr is-{{slug}}"></span>
                  <abbr title="{{titulo}}">{{nombre}}</abbr>
                </label>
              </div>
              {{/each}}
            </fieldset>
          </div>
        </li>
      </ul>
    </div>
    <p class="v-elec-intro__note">Todas las respuestas de este cuestionario son anónimas</p>
  </div>
</div>
