<div class="v-n-pm" data-perspective-map aria-label="Mapa de las fuentes del Paseo del Prado">
  <div class="v-n-pm__bleed">
    <div class="v-n-pm__stage">
      <div class="v-n-pm__index" aria-hidden="true">
        <div class="v-n-pm__index-item">
          <span>Estatua de Cibeles</span>
          <img src="assets/images/statue-01.webp" alt="">
        </div>
        <div class="v-n-pm__index-item">
          <span>Estatua de Apolo</span>
          <img src="assets/images/statue-02.webp" alt="">
        </div>
        <div class="v-n-pm__index-item">
          <span>Estatua de Neptuno</span>
          <img src="assets/images/statue-03.webp" alt="">
        </div>
      </div>

      <svg class="v-n-pm__connectors" aria-hidden="true">
        <polygon data-pm-diamond></polygon>
        <polygon data-pm-diamond></polygon>
        <polygon data-pm-diamond></polygon>
        <line data-pm-connector></line>
        <line data-pm-connector></line>
        <line data-pm-connector></line>
      </svg>

      <div class="v-n-pm__scene">
        <div class="v-n-pm__plane">
          <div class="v-n-pm__content">
            <img
              class="v-n-pm__map"
              src="assets/images/mapa-madrid.webp"
              alt="Mapa del eje del Paseo del Prado y el Paseo de Recoletos"
            >

            <span class="v-n-pm__dot v-n-pm__dot--cibeles" aria-hidden="true"></span>
            <span class="v-n-pm__dot v-n-pm__dot--apolo" aria-hidden="true"></span>
            <span class="v-n-pm__dot v-n-pm__dot--neptuno" aria-hidden="true"></span>

            <figure class="v-n-pm__monument v-n-pm__monument--cibeles">
              <span class="v-n-pm__shadow" aria-hidden="true">
                <img src="assets/images/statue-01.webp" alt="">
              </span>
              <span class="v-n-pm__billboard">
                <img src="assets/images/statue-01.webp" alt="Fuente de Cibeles">
              </span>
            </figure>

            <figure class="v-n-pm__monument v-n-pm__monument--apolo">
              <span class="v-n-pm__shadow" aria-hidden="true">
                <img src="assets/images/statue-02.webp" alt="">
              </span>
              <span class="v-n-pm__billboard">
                <img src="assets/images/statue-02.webp" alt="Fuente de Apolo">
              </span>
            </figure>

            <figure class="v-n-pm__monument v-n-pm__monument--neptuno">
              <span class="v-n-pm__shadow" aria-hidden="true">
                <img src="assets/images/statue-03.webp" alt="">
              </span>
              <span class="v-n-pm__billboard">
                <img src="assets/images/statue-03.webp" alt="Fuente de Neptuno">
              </span>
            </figure>
          </div>
        </div>
      </div>

      <!-- Fuera del plano 3D: solo para leer labels en localhost (same-origin). -->
      <object
        class="v-n-pm__map-data"
        data="assets/images/mapa-madrid.svg"
        type="image/svg+xml"
        aria-hidden="true"
        tabindex="-1"
      ></object>
    </div>
  </div>
</div>
