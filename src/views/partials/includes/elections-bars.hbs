<div class="v-elec-bars">
  <h3 class="v-elec-t">Cómo de cerca estás de tu partido <br> político según la pregunta</h3>

  <div class="v-slc-c v-slc-c--c v-slc-c--stk">
    <div class="v-slc" data-voc-component="select">
      <button class="v-slc__h v-slc__b" type="button">
        <span class="v-slc__t">
          <span class="v-slc__party-color is-default"></span>
          -
        </span>
        <span class="v-b-i">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true">
            <path d="M7.49674 9C7.32756 9 7.17008 8.97123 7.02429 8.91368C6.87851 8.85613 6.73987 8.75748 6.60836 8.61773L0.29849 1.90015C0.104272 1.69313 0.00482265 1.43293 0.000142691 1.11954C-0.00430327 0.806395 0.0951459 0.541457 0.29849 0.324725C0.502068 0.108242 0.748702 0 1.03839 0C1.32808 0 1.57471 0.108242 1.77829 0.324725L7.49674 6.41304L13.2152 0.324725C13.4096 0.117957 13.654 0.0120823 13.9484 0.00709995C14.2425 0.00236671 14.4914 0.108242 14.695 0.324725C14.8983 0.541457 15 0.804028 15 1.11244C15 1.42084 14.8983 1.68341 14.695 1.90015L8.38511 8.61773C8.2536 8.75748 8.11496 8.85613 7.96918 8.91368C7.8234 8.97123 7.66592 9 7.49674 9Z" fill="currentColor"/>
          </svg>
        </span>
      </button>
      <div class="v-slc__c">
        <div class="v-slc__n">
          <ul class="v-slc__u">
            {{#each elecciones.partidos}}
            <li class="v-slc__l">
              <button class="v-slc__a" type="button" data-party="{{slug}}">
                <span class="v-slc__party-color is-{{slug}}"></span>
                {{nombre}}
              </button>
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="v-elec-bars__list">
    {{#each elecciones.preguntas}}
    <div class="v-elec-bars__item" style="--distance: 0" data-elec-q="{{id}}">
      <p class="v-elec-bars__k"><b>{{n}}</b>/{{total}} <b>{{familia}}</b></p>
      <p class="v-elec-bars__q">{{claim}}</p>
      <div class="v-elec-bars__bar">
        <div class="v-elec-bars__track">
          <span class="v-elec-bars__fill"></span>
          <span class="v-elec-bars__dot v-elec-bars__dot--party is-default"></span>
          <span class="v-elec-bars__dot v-elec-bars__dot--you"></span>
        </div>
        <div class="v-elec-bars__labels">
          <span class="v-elec-bars__name v-elec-bars__name--party is-on-top"></span>
          <span class="v-elec-bars__name v-elec-bars__name--you">Tú</span>
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  <button class="v-elec-bars__more" type="button">
    <span class="v-b-i">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true">
        <path d="M7.49674 9C7.32756 9 7.17008 8.97123 7.02429 8.91368C6.87851 8.85613 6.73987 8.75748 6.60836 8.61773L0.29849 1.90015C0.104272 1.69313 0.00482265 1.43293 0.000142691 1.11954C-0.00430327 0.806395 0.0951459 0.541457 0.29849 0.324725C0.502068 0.108242 0.748702 0 1.03839 0C1.32808 0 1.57471 0.108242 1.77829 0.324725L7.49674 6.41304L13.2152 0.324725C13.4096 0.117957 13.654 0.0120823 13.9484 0.00709995C14.2425 0.00236671 14.4914 0.108242 14.695 0.324725C14.8983 0.541457 15 0.804028 15 1.11244C15 1.42084 14.8983 1.68341 14.695 1.90015L8.38511 8.61773C8.2536 8.75748 8.11496 8.85613 7.96918 8.91368C7.8234 8.97123 7.66592 9 7.49674 9Z" fill="currentColor"/>
      </svg>
    </span>
    Ver más
  </button>
</div>