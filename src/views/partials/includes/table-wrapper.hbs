<div class="v-n-table-wrapper">
  <div class="v-n-table-wrapper__top">
    <form class="v-frm">
      <div class="v-frm__c">
        <div class="v-frm__w">
          <input id="communitySearch" type="text" class="v-frm__i" placeholder="Buscar comunidad, provincia o localidad..." disabled>
          <button id="clearSearch" class="v-frm__clear" type="button" hidden aria-label="Borrar búsqueda">×</button>
        </div>
      </div>
    </form>
  </div>

  <div class="community-heading">
    <span>Comunidad Autónoma</span>
  </div>

  <div id="loadingMessage" class="community-message">
    Cargando datos...
  </div>

  <div id="communitiesContainer"></div>

  <div id="emptyResults" class="community-message" hidden>
    No se han encontrado resultados.
  </div>
</div>