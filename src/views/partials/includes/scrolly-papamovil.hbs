<div class="v-n-scrolly scrolly-papamovil">
  <div class="v-n-scrolly__sticky">
    <div class="v-n-scrolly__c">
      <div class="v-n-scrolly__static">
        <div class="inf-c">
          <h3 class="title">El Papamóvil actual : un Mercedes-Benz G 580</h3>
          <p class="desc">Se trata de un vehículo 100% eléctrico adaptado para velocidades lentas, blindado y personalizado</p>
          <div class="btn-c">
            <button class="btn-i is-active" type="button" data-scroll-bg="0">Exterior</button>
            <button class="btn-i" type="button" data-scroll-bg="1">Interior</button>
          </div>
        </div>
      </div>
      <div class="v-n-scrolly__bg">
        <div class="bg-item" data-bg="0">
          {{> ./ai2html/estado-uno }}
          {{> ./ai2html/estado-dos }}
        </div>
        <div class="bg-item" data-bg="1">
          {{> ./ai2html/estado-tres }}
          {{> ./ai2html/estado-cuatro }}
        </div>
      </div>
    </div>
  </div>

    <div class="v-n-scrolly__steps">
    <div class="step" data-bg="0" data-state="1"></div>  
    <div class="step is-mobile-only" data-bg="0" data-state="2"></div>  
    <div class="step" data-bg="1" data-state="1"></div>  
    <div class="step is-mobile-only" data-bg="1" data-state="2"></div>
  </div>
</div>