                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <use href="#icon-share-tw"></use>
                    </svg>
                  </span>
                  <p class="v-p">X</p>
                </button>
              </li>
              <li class="v-sld__s">
                <button class="v-i-c v-i-c--4" type="button" data-elec-red="linkedin" data-voc-vtm-id="compartirrrss" data-voc-vtm-info="compartir-resultado-elecciones-linkedin">
                  <span class="v-i">
                    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                      <use href="#icon-share-linkedin"></use>
                    </svg>
                  </span>
                  <p class="v-p">LinkedIn</p>
                </button>
              </li>
              <li class="v-sld__s">
                <button class="v-i-c v-i-c--5" type="button" data-elec-red="telegram" data-voc-vtm-id="compartirrrss" data-voc-vtm-info="compartir-resultado-elecciones-telegram">
