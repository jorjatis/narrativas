                </button>
              </li>
              <li class="v-sld__s">
                <button class="v-i-c v-i-c--2" type="button" data-elec-red="facebook" data-voc-vtm-id="compartirrrss" data-voc-vtm-info="compartir-resultado-elecciones-facebook">
                  <span class="v-i">
                    <svg width="7" height="14" viewBox="0 0 7 14" aria-hidden="true">
                      <use href="#icon-share-fb"></use>
                    </svg>
                  </span>
