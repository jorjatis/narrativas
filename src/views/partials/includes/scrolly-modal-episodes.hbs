<div class="episodes-modal-overlay" aria-hidden="true"></div>

{{#each episodes}}
<div class="episodes-modal" data-episode="{{inc @index}}" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="episode-title-{{inc @index}}">
  <h2 id="episode-title-{{inc @index}}" class="sr-only">{{episodeTitle}}</h2>
  <div class="episodes-modal__c">
    <div class="episodes-modal__scroll v-n-scrolly-scroller">
      <div class="v-n-scrolly" data-scrolly-id="episode-{{inc @index}}">
        <div class="v-n-scrolly__sticky">
          <div class="v-n-scrolly__bg">
            {{#each items}}
              <div class="bg-item bg-item--{{inc @index}}" data-bg="{{@index}}">
                <figure>
                  <div class="img-c {{#if itemImageSrcHasBg}}img-c--bg{{/if}}">
                    <img src="{{itemImageSrc}}" alt="{{default itemImageFigcaption}}">
                  </div>
                  <figcaption>
                    <strong>© Fotografía: {{itemImageAuthor}}</strong>
                    {{#if itemImageFigcaption}}
                      {{itemImageFigcaption}}
                    {{/if}}
                  </figcaption>
                </figure>
              </div>
            {{/each}}
            <div class="bg-item bg-item--replay" data-bg="replay">
              <figure>
                <div class="img-c">
                  {{#each items}}
                    {{#if @last}}
                      <img src="{{itemImageSrc}}" alt="" aria-hidden="true">
                    {{/if}}
                  {{/each}}
                  <div class="episode-replay__dim" aria-hidden="true"></div>
                  <button class="episode-replay__btn" type="button">
                    <svg class="episode-replay__icon" width="15" height="16" viewBox="0 0 15 16" aria-hidden="true">
                      <path d="M7.5 15.5C5.4062 15.5 3.6328 14.7736 2.1798 13.3207C0.726598 11.8679 0 10.0948 0 8.0015C0 5.9082 0.726598 4.1346 2.1798 2.6807C3.6328 1.2269 5.4062 0.5 7.5 0.5C8.6692 0.5 9.7756 0.759899 10.8193 1.2797C11.8628 1.7997 12.7307 2.5334 13.423 3.4807V1.25C13.423 1.0375 13.4949 0.859399 13.6387 0.715799C13.7826 0.571899 13.9608 0.5 14.1733 0.5C14.3859 0.5 14.564 0.571899 14.7075 0.715799C14.8512 0.859399 14.923 1.0375 14.923 1.25V5.7115C14.923 5.9677 14.8364 6.1823 14.6633 6.3555C14.4899 6.5287 14.2753 6.6152 14.0193 6.6152H9.5577C9.3452 6.6152 9.1671 6.5434 9.0232 6.3997C8.8796 6.2559 8.8077 6.0777 8.8077 5.865C8.8077 5.6525 8.8796 5.4744 9.0232 5.3307C9.1671 5.1872 9.3452 5.1155 9.5577 5.1155H12.7577C12.2307 4.15 11.4999 3.3894 10.5653 2.8337C9.6308 2.2779 8.609 2 7.5 2C5.8333 2 4.4167 2.5833 3.25 3.75C2.0833 4.9167 1.5 6.3333 1.5 8C1.5 9.6667 2.0833 11.0833 3.25 12.25C4.4167 13.4167 5.8333 14 7.5 14C8.6622 14 9.7261 13.6948 10.6918 13.0845C11.6574 12.4743 12.389 11.6602 12.8865 10.6423C12.9813 10.4602 13.1208 10.333 13.3048 10.2605C13.4888 10.1882 13.6763 10.184 13.8673 10.248C14.0711 10.3122 14.2138 10.4455 14.2952 10.648C14.3766 10.8507 14.3698 11.043 14.275 11.225C13.6557 12.5198 12.7415 13.556 11.5325 14.3335C10.3235 15.1112 8.9793 15.5 7.5 15.5Z"/>                    </svg>
                    <span class="episode-replay__action">Volver a ver</span>
                    <span class="episode-replay__title">{{episodeTitle}}</span>
                  </button>
                </div>
              </figure>
            </div>
            <button class="modal-close" type="button" aria-label="Cerrar">
              <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.0006 13.0635L8.75438 16.3095C8.60954 16.4545 8.43396 16.5254 8.22763 16.522C8.02113 16.5189 7.84546 16.4449 7.70063 16.3C7.55579 16.1552 7.48338 15.978 7.48338 15.7683C7.48338 15.5586 7.55579 15.3814 7.70063 15.2365L10.9371 12L7.69113 8.7788C7.54613 8.63396 7.47529 8.45671 7.47863 8.24705C7.48179 8.03755 7.55579 7.86038 7.70063 7.71555C7.84546 7.57055 8.02271 7.49805 8.23238 7.49805C8.44204 7.49805 8.6193 7.57055 8.76413 7.71555L12.0006 10.9615L15.2219 7.71555C15.3667 7.57055 15.5423 7.49805 15.7486 7.49805C15.9551 7.49805 16.1308 7.57055 16.2756 7.71555C16.4308 7.87055 16.5084 8.0503 16.5084 8.2548C16.5084 8.4593 16.4308 8.63396 16.2756 8.7788L13.0391 12L16.2851 15.2463C16.4301 15.3911 16.5026 15.5667 16.5026 15.773C16.5026 15.9795 16.4301 16.1552 16.2851 16.3C16.1301 16.4552 15.9504 16.5328 15.7459 16.5328C15.5414 16.5328 15.3667 16.4552 15.2219 16.3L12.0006 13.0635Z"/></svg>
            </button>
            <div class="pagination">
              {{#each items}}
                <button type="button" data-slide="{{@index}}" aria-label="Ir al paso {{inc @index}} de {{../items.length}}"{{#if @first}} class="is-active" aria-current="true"{{/if}}><span aria-hidden="true"></span></button>
              {{/each}}
            </div>
            <div class="episode-btn-c">
              <button class="episode-btn episode-btn--prev" type="button" {{#if @first}}disabled{{/if}}{{#unless @first}} aria-label="Episodio anterior: {{episodeNav ../episodes @index "prev" "episodeTitle"}}"{{/unless}}>
                <svg class="icon-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.0743 8.50022H3.5C3.35811 8.50022 3.23933 8.45233 3.14367 8.35655C3.04789 8.26088 3 8.14211 3 8.00022C3 7.85833 3.04789 7.73955 3.14367 7.64388C3.23933 7.54811 3.35811 7.50022 3.5 7.50022H11.0743L8.8795 5.30538C8.78039 5.20616 8.73145 5.0901 8.73267 4.95722C8.734 4.82433 8.78295 4.70616 8.8795 4.60272C8.98295 4.49938 9.10172 4.44599 9.23583 4.44255C9.37006 4.4391 9.48889 4.4891 9.59233 4.59255L12.5782 7.57838C12.6406 7.64083 12.6846 7.70666 12.7102 7.77588C12.7358 7.84511 12.7487 7.91988 12.7487 8.00022C12.7487 8.08055 12.7358 8.15533 12.7102 8.22455C12.6846 8.29377 12.6406 8.35961 12.5782 8.42205L9.59233 11.4079C9.49311 11.507 9.37539 11.5559 9.23917 11.5547C9.10283 11.5534 8.98295 11.501 8.8795 11.3977C8.78295 11.2943 8.73294 11.1772 8.7295 11.0464C8.72606 10.9156 8.77606 10.7985 8.8795 10.6951L11.0743 8.50022Z"/></svg>
                <span class="episode-btn__title">
                  {{#unless @first}}
                    <span class="episode-btn__prev-ep">Ep<span>isodio</span><span>. </span> anterior</span>
                    {{episodeNav ../episodes @index "prev" "episodeTitle"}}
                  {{/unless}}
                </span>
              </button>
              <button class="episode-btn episode-btn--next" type="button" {{#if @last}}disabled{{/if}}{{#unless @last}} aria-label="Episodio siguiente: {{episodeNav ../episodes @index "next" "episodeTitle"}}"{{/unless}}>
                <span class="episode-btn__title">
                  {{#unless @last}}
                  <span class="episode-btn__next-ep">Siguiente Ep<span>isodio</span><span>.</span></span>
                    {{episodeNav ../episodes @index "next" "episodeTitle"}}
                  {{/unless}}
                </span>
                <svg class="icon-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.0743 8.50022H3.5C3.35811 8.50022 3.23933 8.45233 3.14367 8.35655C3.04789 8.26088 3 8.14211 3 8.00022C3 7.85833 3.04789 7.73955 3.14367 7.64388C3.23933 7.54811 3.35811 7.50022 3.5 7.50022H11.0743L8.8795 5.30538C8.78039 5.20616 8.73145 5.0901 8.73267 4.95722C8.734 4.82433 8.78295 4.70616 8.8795 4.60272C8.98295 4.49938 9.10172 4.44599 9.23583 4.44255C9.37006 4.4391 9.48889 4.4891 9.59233 4.59255L12.5782 7.57838C12.6406 7.64083 12.6846 7.70666 12.7102 7.77588C12.7358 7.84511 12.7487 7.91988 12.7487 8.00022C12.7487 8.08055 12.7358 8.15533 12.7102 8.22455C12.6846 8.29377 12.6406 8.35961 12.5782 8.42205L9.59233 11.4079C9.49311 11.507 9.37539 11.5559 9.23917 11.5547C9.10283 11.5534 8.98295 11.501 8.8795 11.3977C8.78295 11.2943 8.73294 11.1772 8.7295 11.0464C8.72606 10.9156 8.77606 10.7985 8.8795 10.6951L11.0743 8.50022Z"/></svg>
              </button>
            </div>
          </div>
        </div>
        <div class="v-n-scrolly__steps">
          {{#each items}}
            <article class="step" data-step="{{@index}}" data-bg="{{@index}}">
              <div class="step-content">
                <span class="step-date"><span class="step-date-day">{{itemDateDay}}</span> <span class="step-date-month">{{itemDateMonth}}</span></span>
                <p class="step-text">{{itemTextStep}}</p>
                <div class="step-audio">
                  <div class="v-cmp-ply">
                    <div class="v-ply v-ply--t3" data-audio-player>
                      <div class="v-ply__c">
                        <div class="v-ply__w v-ply__w--1">
                          <button class="v-ply__b v-ply__b--1" type="button" aria-label="Reproducir">
                            <span class="v-ply__i">
                              <svg class="icon-play" width="15" height="18" viewBox="0 0 15 18" aria-hidden="true">
