                              </svg>
                              <svg class="icon-pause" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                                <path d="M2.2091 0.0345001C2.4996 0.0345001 2.7508 0.1438 2.9612 0.3631C3.1716 0.5826 3.2769 0.8446 3.2769 1.1476V8.8524C3.2769 9.1554 3.1716 9.4174 2.9612 9.6369C2.7508 9.8562 2.4996 9.9655 2.2091 9.9655H1.1013C0.811 9.9655 0.5605 9.856 0.3502 9.6369C0.1398 9.4174 0.0345001 9.1554 0.0345001 8.8524V1.1476C0.0345001 0.8446 0.1398 0.5826 0.3502 0.3631C0.5605 0.144 0.811 0.0345001 1.1013 0.0345001H2.2091Z"/>
                                <path d="M8.8987 0.0345001C9.189 0.0345001 9.4395 0.144 9.6498 0.3631C9.8602 0.5826 9.9655 0.8446 9.9655 1.1476V8.8524C9.9655 9.1554 9.8602 9.4174 9.6498 9.6369C9.4395 9.856 9.189 9.9655 8.8987 9.9655H7.7909C7.5004 9.9655 7.2492 9.8562 7.0388 9.6369C6.8284 9.4174 6.7231 9.1554 6.7231 8.8524V1.1476C6.7231 0.8446 6.8284 0.5826 7.0388 0.3631C7.2492 0.1438 7.5004 0.0345001 7.7909 0.0345001H8.8987Z"/>
                              </svg>
                            </span>
                          </button>
                        </div>
                        <div class="v-ply__w v-ply__w--2">
                          <div class="v-ply__g v-ply__g--2">
                            <div class="v-ply__v" tabindex="0" role="slider" aria-label="Posición del audio" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="00:00">
                              <progress value="0" max="100"></progress>
                            </div>
                          </div>
                          <p class="v-ply__g v-ply__g--3">
                            <span class="v-ply__p">
                              <span class="v-ply__p-length">00:00</span>
                              <span class="v-ply__p-duration">00:00</span>
                            </span>
                          </p>
                        </div>
                        <div class="v-ply__w v-ply__w--3">
                          <button class="v-ply__b v-ply__b--2" type="button" aria-label="Silenciar">
                            <svg class="icon-sound-off" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M14.0383 6.77908L11.9653 8.85233C11.8268 8.99066 11.6527 9.06149 11.443 9.06483C11.2335 9.06799 11.0563 8.99716 10.9113 8.85233C10.7664 8.70732 10.694 8.53166 10.694 8.32533C10.694 8.11899 10.7664 7.94333 10.9113 7.79833L12.9845 5.72533L10.9113 3.65233C10.7729 3.51383 10.7022 3.33974 10.699 3.13008C10.6957 2.92058 10.7664 2.74333 10.9113 2.59833C11.0563 2.45349 11.2319 2.38108 11.4383 2.38108C11.6448 2.38108 11.8204 2.45349 11.9653 2.59833L14.0383 4.67158L16.1112 2.59833C16.2498 2.45999 16.4238 2.38916 16.6335 2.38583C16.8432 2.38266 17.0204 2.45349 17.1653 2.59833C17.3101 2.74333 17.3825 2.91899 17.3825 3.12533C17.3825 3.33166 17.3101 3.50733 17.1653 3.65233L15.092 5.72533L17.1653 7.79833C17.3038 7.93683 17.3746 8.11091 17.3778 8.32058C17.3809 8.53008 17.3101 8.70732 17.1653 8.85233C17.0204 8.99716 16.8447 9.06958 16.6383 9.06958C16.4319 9.06958 16.2563 8.99716 16.1112 8.85233L14.0383 6.77908ZM3.7115 8.22533H0.90375C0.646083 8.22533 0.431 8.13908 0.2585 7.96658C0.0861666 7.79424 0 7.57916 0 7.32133V4.12933C0 3.87149 0.0861666 3.65641 0.2585 3.48408C0.431 3.31158 0.646083 3.22533 0.90375 3.22533H3.7115L6.70375 0.233076C6.94342 -0.00659108 7.21933 -0.0614248 7.5315 0.0685752C7.84367 0.198742 7.99975 0.434326 7.99975 0.775326V10.6753C7.99975 11.0163 7.84367 11.2519 7.5315 11.3821C7.21933 11.5121 6.94342 11.4572 6.70375 11.2176L3.7115 8.22533ZM6.49975 2.57533L4.34975 4.72533H1.49975V6.72533H4.34975L6.49975 8.87533V2.57533Z"/></svg>
