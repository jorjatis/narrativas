                          </button>
                        </div>
                        <audio preload="none" src="{{itemAudioSrc}}.mp3" playsinline></audio>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          {{/each}}
          <article class="step step--end" data-step="end">
            <span class="sr-only">Final del episodio</span>
          </article>
        </div>
      </div>
    </div>
    <div class="scr-ind" aria-hidden="true">
      <div class="scr-ind__c">
        <span class="scr-ind__m" aria-hidden="true">
          <span class="scr-ind__w"></span>
        </span>
        <span class="scr-ind__txt" role="status">Desliza hacia abajo para continuar</span>
      </div>
    </div>
  </div>
</div>
{{/each}}
