<button class="open-modal v-btn v-btn-g v-btn--l" data-episode="0">
  Abrir
</button>

<div class="episodes-modal">
  <div class="episodes-modal__c">
    <div class="episodes-modal__scroll v-n-scrolly-scroller">
      <div class="episodes-slider">
          <section class="episode episode--1 {{#if active}}active{{/if}}">
            <div class="v-n-scrolly">
              <div class="v-n-scrolly__sticky">
                <div class="v-n-scrolly__bg">
                  {{#each items}}
                    <div class="bg-item bg-item--{{inc @index}}" data-bg="{{@index}}">
                      <figure>
                        <div class="img-c">
                          <img src="https://picsum.photos/id/12{{inc @index}}/200/300">
                        </div>
                        <figcaption>
                          <strong>© Fotografía: {{itemImageAuthor}}</strong>
                          {{itemText}}
                        </figcaption>
                      </figure>
                    </div>
                  {{/each}}
                  <button class="modal-close"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20"><path stroke="#fff" d="m6 6 8 8M14 6l-8 8"/></svg></button>
                  <div class="pagination">
                    {{#each items}}
                      <button data-slide="{{@index}}" {{#ifCond @index "==" 0}}class="is-active"{{/ifCond}}><span></span></button>
                    {{/each}}
                  </div>
                  <div class="episode-btn-c">
                    <button class="episode-btn episode-btn--prev">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 31 15"><path fill="#f9f6ee" d="M.293 8.071a1 1 0 0 1 0-1.414L6.657.293A1 1 0 0 1 8.07 1.707L2.414 7.364l5.657 5.657a1 1 0 1 1-1.414 1.414zM31 7.364v1H1v-2h30z"/></svg>
                      <span class="episode-btn__title">Nombre <br> episodio anterior</span>
                    </button>
                    <button class="episode-btn episode-btn--next">
                      <span class="episode-btn__title">Nombre <br> episodio siguiente</span>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 31 15"><path fill="#f9f6ee" d="M30.707 8.071a1 1 0 0 0 0-1.414L24.343.293a1 1 0 1 0-1.414 1.414l5.657 5.657-5.657 5.657a1 1 0 0 0 1.414 1.414zM0 7.364v1h30v-2H0z"/></svg>
                    </button>
                  </div>
                </div> 
              </div>
              <div class="v-n-scrolly__steps">
                {{#each items}}
                <article class="step" data-step="{{@index}}">
                  <div class="step-content">
                    <span class="step-date"><span class="step-date-day">{{itemDateDay}}</span> <span class="step-date-month">{{itemDateMonth}}</span></span>
                    <p class="step-text">{{itemText}}</p>
                    <div class="step-audio">
                      <div class="v-cmp-ply">
                          <div class="v-ply v-ply--t3">
                            <div class="v-ply__c">
                              <div class="v-ply__w v-ply__w--1">
                                <button class="v-ply__b v-ply__b--1">
                                  <span class="v-ply__i">
                                    <svg width="15" height="18" viewBox="0 0 15 18" id="icon-play" aria-hidden="true">
                                      <path d="M0.167999 16.4068V1.5927C0.167999 1.1527 0.318899 0.791595 0.620899 0.509295C0.922799 0.227395 1.2752 0.0863953 1.678 0.0863953C1.8038 0.0863953 1.9357 0.104595 2.0738 0.140995C2.2119 0.177095 2.3437 0.231596 2.4692 0.304296L14.1292 7.7273C14.3581 7.8834 14.5296 8.07029 14.6438 8.28809C14.7582 8.50609 14.8155 8.74339 14.8155 8.99979C14.8155 9.25609 14.7582 9.49339 14.6438 9.71139C14.5296 9.92919 14.3581 10.1161 14.1292 10.2723L2.4692 17.6952C2.3434 17.768 2.2112 17.8224 2.0726 17.8585C1.9342 17.8949 1.8021 17.9131 1.6763 17.9131C1.2732 17.9131 0.921199 17.7721 0.620099 17.4902C0.318699 17.208 0.167999 16.8468 0.167999 16.4068Z"/>
                                    </svg>
                                    <svg width="10" height="10" viewBox="0 0 10 10" id="icon-pause" aria-hidden="true">
                                       <path d="M2.2091 0.0345001C2.4996 0.0345001 2.7508 0.1438 2.9612 0.3631C3.1716 0.5826 3.2769 0.8446 3.2769 1.1476V8.8524C3.2769 9.1554 3.1716 9.4174 2.9612 9.6369C2.7508 9.8562 2.4996 9.9655 2.2091 9.9655H1.1013C0.811 9.9655 0.5605 9.856 0.3502 9.6369C0.1398 9.4174 0.0345001 9.1554 0.0345001 8.8524V1.1476C0.0345001 0.8446 0.1398 0.5826 0.3502 0.3631C0.5605 0.144 0.811 0.0345001 1.1013 0.0345001H2.2091Z"/><path d="M8.8987 0.0345001C9.189 0.0345001 9.4395 0.144 9.6498 0.3631C9.8602 0.5826 9.9655 0.8446 9.9655 1.1476V8.8524C9.9655 9.1554 9.8602 9.4174 9.6498 9.6369C9.4395 9.856 9.189 9.9655 8.8987 9.9655H7.7909C7.5004 9.9655 7.2492 9.8562 7.0388 9.6369C6.8284 9.4174 6.7231 9.1554 6.7231 8.8524V1.1476C6.7231 0.8446 6.8284 0.5826 7.0388 0.3631C7.2492 0.1438 7.5004 0.0345001 7.7909 0.0345001H8.8987Z"/>
                                    </svg>
                                  </span>
                                </button>
                              </div>
                              <div class="v-ply__w v-ply__w--2">
                                <div class="v-ply__g v-ply__g--2">
                                  <div class="v-ply__v">
                                    <progress value="0" max="0"></progress>
                                  </div>
                                </div>
                                <p class="v-ply__g v-ply__g--3">
                                  <span class="v-ply__p">
                                    <span class="v-ply__p-length">02:21</span>
                                    <span class="v-ply__p-duration">04:00</span>
                                  </span>
                                </p>
                              </div>
                              <div class="v-ply__w v-ply__w--3">
                                <button class="v-ply__b v-ply__b--2">
                                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 18"><path stroke="#000" stroke-linejoin="round" stroke-width=".5" d="M4.818 4.818H.25v7.614h6.09L9.387 17V.25z"/></svg>
                                </button>
                              </div>
                              <audio src="{{itemAudioSrc}}"></audio>
                            </div>
                          </div>
                      </div>
                    </div>
                  </div>
                </article>
                {{/each}}
              </div>
            </div>
          </section>      
      </div>
    </div>    
  </div>
</div>