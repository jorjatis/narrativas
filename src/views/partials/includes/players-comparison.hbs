<div class="v-n-players-comparison">
  <div class="v-n-suh v-n-suh--02">
    <span class="v-n-suh__l"></span>
    <h3 class="v-n-suh__t">Compara <br> sus datos</h3>
  </div>

  <p class="v-n-players-comparison__lead">Las estadísticas recopiladas hacen referencia exclusivamente a partidos de la fase final del Mundial en los que el jugador lucía el 10</p>

  <div class="v-n-players-comparison__c">
    <div class="v-n-players-comparison__picks">
      <div class="v-slc" data-side="left" data-voc-component="select">
        <button class="v-slc__h v-slc__b" type="button">
          <span class="v-slc__t">Lionel Messi</span>
          <span class="v-b-i">
            <svg width="8" height="5" aria-hidden="true">
              <path d="M3.99919 4.78467C3.91885 4.78467 3.84408 4.77184 3.77485 4.74617C3.70563 4.72051 3.6398 4.67651 3.57735 4.61417L0.581188 1.61801C0.488965 1.52568 0.441743 1.40962 0.439521 1.26984C0.43741 1.13017 0.484632 1.01201 0.581188 0.915341C0.677854 0.818786 0.794965 0.770508 0.932521 0.770508C1.07008 0.770508 1.18719 0.818786 1.28385 0.915341L3.99919 3.63084L6.71452 0.915341C6.80685 0.823119 6.92291 0.775897 7.06269 0.773675C7.20235 0.771563 7.32052 0.818786 7.41719 0.915341C7.51374 1.01201 7.56202 1.12912 7.56202 1.26667C7.56202 1.40423 7.51374 1.52134 7.41719 1.61801L4.42102 4.61417C4.35858 4.67651 4.29274 4.72051 4.22352 4.74617C4.1543 4.77184 4.07952 4.78467 3.99919 4.78467Z"/>
            </svg>
          </span>
        </button>
        <div class="v-slc__c">
          <div class="v-slc__n">
            <ul class="v-slc__u"></ul>
          </div>
        </div>
      </div>
      <div class="v-slc" data-side="right" data-voc-component="select">
        <button class="v-slc__h v-slc__b" type="button">
          <span class="v-slc__t">Juan Román Riquelme</span>
          <span class="v-b-i">
            <svg width="8" height="5" aria-hidden="true">
              <path d="M3.99919 4.78467C3.91885 4.78467 3.84408 4.77184 3.77485 4.74617C3.70563 4.72051 3.6398 4.67651 3.57735 4.61417L0.581188 1.61801C0.488965 1.52568 0.441743 1.40962 0.439521 1.26984C0.43741 1.13017 0.484632 1.01201 0.581188 0.915341C0.677854 0.818786 0.794965 0.770508 0.932521 0.770508C1.07008 0.770508 1.18719 0.818786 1.28385 0.915341L3.99919 3.63084L6.71452 0.915341C6.80685 0.823119 6.92291 0.775897 7.06269 0.773675C7.20235 0.771563 7.32052 0.818786 7.41719 0.915341C7.51374 1.01201 7.56202 1.12912 7.56202 1.26667C7.56202 1.40423 7.51374 1.52134 7.41719 1.61801L4.42102 4.61417C4.35858 4.67651 4.29274 4.72051 4.22352 4.74617C4.1543 4.77184 4.07952 4.78467 3.99919 4.78467Z"/>
            </svg>
          </span>
        </button>
        <div class="v-slc__c">
          <div class="v-slc__n">
            <ul class="v-slc__u"></ul>
          </div>
        </div>
      </div>
    </div>

    <div class="player player-left">
      <figure class="player-img">
        <img src="" alt="Lionel Messi" hidden>
      </figure>

      <div class="player-position">
        <span class="player-position__label">Posición</span>
        <span class="player-position__value"></span>
        <img class="player-pitch" src="" alt="" hidden>
      </div>
    </div>

    <ul class="comparison-stats">
      <li class="stat-row stat-row--text" data-stat="titles">
        <span class="stat-row__label">Títulos</span>
        <div class="stat-row__texts">
          <span class="stat-row__text stat-row__text--left"></span>
          <span class="stat-row__divider"></span>
          <span class="stat-row__text stat-row__text--right"></span>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="matches">
        <span class="stat-row__label">Nº de partidos</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="minutes">
        <span class="stat-row__label">Minutos jugados</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="goals">
        <span class="stat-row__label">Goles</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="goalsPer90">
        <span class="stat-row__label">Promedio de goles 90'</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="goalsAfter80">
        <span class="stat-row__label">% Goles anotados después del min. 80</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>

      <li class="stat-row stat-row--bar" data-stat="teamGoalsOnPitch">
        <span class="stat-row__label">Nº de goles del equipo estando él en el campo</span>
        <div class="stat-row__track">
          <div class="stat-bar stat-bar--left">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
          <div class="stat-bar stat-bar--right">
            <div class="stat-bar__fill"></div>
            <span class="stat-bar__cap" aria-hidden="true"></span>
            <span class="stat-bar__value"></span>
          </div>
        </div>
      </li>
    </ul>

    <div class="player player-right">
      <figure class="player-img">
        <img src="" alt="Juan Román Riquelme" hidden>
      </figure>

      <div class="player-position">
        <span class="player-position__label">Posición</span>
        <span class="player-position__value"></span>
        <img class="player-pitch" src="" alt="" hidden>
      </div>
    </div>
  </div>
</div>
