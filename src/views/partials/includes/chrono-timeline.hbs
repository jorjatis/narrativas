                  d="M12 0C5.373 0 0 5.41 0 12.083a12 12 0 0 0 .162 1.99l.008.052.044.245.004.016L7.2 53.166H12L13.927 58H21.6l-4.802-4.833h.002l6.968-38.709q.042-.21.076-.424.053-.321.087-.647.069-.642.069-1.304C24 5.41 18.627 0 12 0" />
                <path fill="#d89603"
