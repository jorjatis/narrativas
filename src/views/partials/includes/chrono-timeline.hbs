                  d="M12 24.167c6.627 0 12-5.41 12-12.084S18.627 0 12 0 0 5.41 0 12.083c0 6.674 5.373 12.084 12 12.084" />
                <path fill="#d89603" d="M21.6 58H2.4l4.8-4.834h9.598z" />
