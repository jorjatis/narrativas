<header class="site-header">
  <div class="site-header__top">
    <a class="site-header__logo-link" href="https://www.abc.es/" target="_blank" rel="noopener noreferrer" aria-label="Ir a ABC">
      <img src="assets/images/logo-abc.svg" alt="" aria-hidden="true" class="logo" width="120" height="38">
    </a>

    <span class="site-header__divider" aria-hidden="true"></span>

    <h1 class="site-header__title" data-reveal-child>Narrativas visuales</h1>

    <div class="site-header__tools">
      <button type="button" class="lang-switch" data-lang-switch aria-label="Cambiar a inglés">
        <span class="lang-switch__label" data-lang-switch-label>EN</span>
      </button>

      <span class="site-header__tools-divider" aria-hidden="true"></span>

      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar a modo oscuro">
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M14.2 3.4A8.3 8.3 0 1 0 20.6 15.1 5.6 5.6 0 0 1 14.2 3.4Z"/>
          </svg>
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <circle cx="12" cy="12" r="4" fill="currentColor"/>
            <path d="M12 2.2v2.4M12 19.4v2.4M4.5 4.5l1.7 1.7M17.8 17.8l1.7 1.7M2.2 12h2.4M19.4 12h2.4M4.5 19.5l1.7-1.7M17.8 6.2l1.7-1.7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>
