<header class="site-header">
  <div class="site-header__top">
    <a class="site-header__logo-link" href="https://www.abc.es/" target="_blank" rel="noopener noreferrer" aria-label="Ir a ABC">
      <img src="assets/images/logo-abc.svg" alt="" aria-hidden="true" class="logo" width="120" height="38">
    </a>

    <span class="site-header__divider" aria-hidden="true"></span>

    <h1 class="site-header__title" data-reveal-child>Narrativas visuales</h1>

    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar a modo oscuro">
      <span class="theme-toggle__label" data-theme-toggle-label>Modo oscuro</span>
    </button>
  </div>

  <div class="site-header__hero">
    <p class="site-header__meta" data-reveal-child>
      {{countPieces months}} {{pluralize (countPieces months) "pieza" "piezas"}}
      <span aria-hidden="true"> · </span>
      {{countMonths months}} {{pluralize (countMonths months) "mes" "meses"}}
    </p>
  </div>
</header>
