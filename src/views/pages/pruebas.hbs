<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f5f3">
    <title>Las fuentes del Paseo del Prado</title>
  </head>
  <body class="p3d-page">
    <main>
      <header class="p3d-intro">
        <p class="p3d-intro__kicker">Madrid monumental</p>
        <h1>Las fuentes que ordenan el paseo</h1>
        <p>Una lectura en perspectiva del eje de Cibeles, Apolo y Neptuno.</p>
      </header>

      <section class="p3d" data-p3d aria-label="Mapa de las fuentes del Paseo del Prado">
        <div class="p3d__stage">
          <svg class="p3d__connectors" aria-hidden="true">
            <line data-p3d-connector></line>
            <line data-p3d-connector></line>
            <line data-p3d-connector></line>
          </svg>

          <div class="p3d__index" aria-hidden="true">
            <div class="p3d__index-item">
              <span>Estatua de Cibeles</span>
              <img src="assets/images/statue-01.webp" alt="">
            </div>
            <div class="p3d__index-item">
              <span>Estatua de Apolo</span>
              <img src="assets/images/statue-02.webp" alt="">
            </div>
            <div class="p3d__index-item">
              <span>Estatua de Neptuno</span>
              <img src="assets/images/statue-03.webp" alt="">
            </div>
          </div>

          <div class="p3d__scene">
            <div class="p3d__plane">
              <div class="p3d__content">
                <img
                  class="p3d__map"
                  src="assets/images/mapa-madrid.svg"
                  alt="Mapa del eje del Paseo del Prado y el Paseo de Recoletos"
                >
                <object
                  class="p3d__map-data"
                  data="assets/images/mapa-madrid.svg"
                  type="image/svg+xml"
                  aria-hidden="true"
                  tabindex="-1"
                ></object>

                <span class="p3d__dot-anchor p3d__dot-anchor--cibeles" aria-hidden="true"></span>
                <span class="p3d__dot-anchor p3d__dot-anchor--apolo" aria-hidden="true"></span>
                <span class="p3d__dot-anchor p3d__dot-anchor--neptuno" aria-hidden="true"></span>

                <figure class="p3d__monument p3d__monument--cibeles">
                  <span class="p3d__shadow"></span>
                  <span class="p3d__billboard">
                    <img src="assets/images/statue-01.webp" alt="Fuente de Cibeles">
                    <figcaption>Cibeles</figcaption>
                  </span>
                </figure>

                <figure class="p3d__monument p3d__monument--apolo">
                  <span class="p3d__shadow"></span>
                  <span class="p3d__billboard">
                    <img src="assets/images/statue-02.webp" alt="Fuente de Apolo">
                    <figcaption>Apolo</figcaption>
                  </span>
                </figure>

                <figure class="p3d__monument p3d__monument--neptuno">
                  <span class="p3d__shadow"></span>
                  <span class="p3d__billboard">
                    <img src="assets/images/statue-03.webp" alt="Fuente de Neptuno">
                    <figcaption>Neptuno</figcaption>
                  </span>
                </figure>
              </div>
            </div>
          </div>

          <p class="p3d__caption">Paseo del Prado, Madrid</p>
        </div>
      </section>

      <section class="p3d-outro">
        <p>Tres fuentes, un mismo eje urbano.</p>
      </section>
    </main>
  </body>
</html>
