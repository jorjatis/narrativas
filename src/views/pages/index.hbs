<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Narrativas visuales | Portfolio ABC</title>
  <meta name="description" content="Selección de narrativas visuales publicadas en ABC. Cada pieza enlaza al reportaje original y a un mockup de archivo.">
  <meta name="theme-color" content="#ffffff" id="theme-color-meta">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <script>
    (function () {
      var theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
      var storedLang = localStorage.getItem('lang');
      var lang = 'es';

      if (storedLang === 'en' || storedLang === 'es') {
        lang = storedLang;
      } else {
        var locales = (navigator.languages && navigator.languages.length)
          ? navigator.languages
          : [navigator.language || ''];
        var prefersSpanish = false;
        for (var i = 0; i < locales.length; i++) {
          if (String(locales[i]).toLowerCase().indexOf('es') === 0) {
            prefersSpanish = true;
            break;
          }
        }
        lang = prefersSpanish ? 'es' : 'en';
      }

      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('lang', lang);
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
</head>

<body>
  <a class="skip-link" href="#main-content">Saltar al contenido</a>
  <div class="site-shell">
    {{> ./header }}
    {{> ./months-nav }}

    <main id="main-content">
      {{> ./month-section}}
    </main>

    {{> ./footer }}
  </div>

</body>

</html>
